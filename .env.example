# Copiez ce fichier en .env puis complétez-le. Ne le partagez jamais (il contient des secrets).

# Connexion à l'interface
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi

# Base de données (valeurs par défaut adaptées au docker-compose)
DB_PASSWORD=handcom

# URL HTTPS publique de votre tunnel vers le port 8080 (ngrok, Cloudflare Tunnel…)
# Exemple : https://hand-com-club.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8080

# URL de l'interface (pour revenir après la connexion d'un compte)
FRONTEND_URL=http://localhost:4200

# App Instagram (Meta for Developers > votre app > Instagram > API setup with Instagram login)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# App TikTok (developers.tiktok.com > votre app)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
